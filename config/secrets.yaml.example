# 复制为 secrets.yaml，权限 0600。不要提交真实密钥。
# HA 原生 secrets 用 !secret；lobn_office 集成选项也可在 UI 填写。

door_open_url: "http://192.168.1.50/relay/0?turn=on&timer={seconds}"
door_close_url: "http://192.168.1.50/relay/0?turn=off"
wecom_webhook: "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=REPLACE"
cloud_base_url: "https://api.example.com"
cloud_hmac_secret: "replace-cloud-hmac-b"
cctv_event_hmac_secret: "replace-cctv-event-hmac-a"
cctv_enroll_url: "http://cctv.lobn:8300/api/internal/persons/enroll"
cctv_enroll_hmac_secret: "replace-cctv-enroll-hmac-c"
