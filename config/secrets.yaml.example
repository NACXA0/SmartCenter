# 复制为 secrets.yaml，chmod 600。勿提交真实值。
# 生产 HA 在 HAOS；本文件给本机可选 HA / 文档对照。

# —— 现行 ——
cloud_base_url: "https://fireclassroom.aleedu.com"
cloud_hmac_secret: "replace-cloud-hmac-b"
# 与 Add-on cloud_hmac_secret / LOBN_SMARTCENTER_RELAY_TOKEN 对齐
wecom_webhook: ""

# Mosquitto（本机联 HAOS 或文档备忘；Add-on 在 HAOS 内由 Supervisor 注入）
mqtt_host: "192.168.1.50"
mqtt_port: 1883
mqtt_user: "homeassistant"
mqtt_password: "replace-mqtt"

# —— 历史（SmartCCTV / HTTP 门，归档后可删）——
# door_open_url: "http://192.168.1.50/relay/0?turn=on&timer={seconds}"
# cctv_event_hmac_secret: "legacy"
