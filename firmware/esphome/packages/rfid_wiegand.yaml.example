# 备选：韦根读头（短线、板旁）
# 用法：在 classroom_node.yaml 中注释 rfid_rs485，改 include 本文件（去掉 .example），
# 并将 substitutions.rfid_transport 改为 wiegand。
# 时序紧：必须用中断/RMT 外挂组件，禁止在 YAML lambda 里位翻转。
# 见 external_components/README.md

substitutions:
  pin_wiegand_d0: GPIO15
  pin_wiegand_d1: GPIO16

# 占位：接入外挂 wiegand 组件后，在 on_tag 里调用：
#   id(rfid_handle_tag)->execute(tag_hex_or_decimal);
#
# external_components:
#   - source: components
#     components: [ wiegand_reader ]
#
# wiegand_reader:
#   - id: gate_reader
#     d0_pin: ${pin_wiegand_d0}
#     d1_pin: ${pin_wiegand_d1}
#     on_tag:
#       then:
#         - lambda: id(rfid_handle_tag)->execute(x);

button:
  - platform: template
    name: "RFID (wiegand) simulate tag"
    on_press:
      - script.execute:
          id: rfid_handle_tag
          tag_id: "WIEGAND-SIM-001"
