# 【可选·终验】把本机 Add-on 临时指到店内 HAOS。
# 日常开发请不要用本文件——用默认 MQTT_HOST=off + 本机 HA（./START.sh dev）。
#
#   cp env.lan.example .env.lan   # .env.lan 勿提交
#   set -a && source .env.lan && set +a
#   ../START.sh addon
#
# 把下面 IP/账号改成店内机；验完取消 source / 改回 MQTT_HOST=off。

SMARTCENTER_DEV_AUTH=1
SMARTCENTER_EMBEDDER=mock
SMARTCENTER_DATA=./data

# 不要用 core-mosquitto（那是 HAOS 容器内网名）
MQTT_HOST=192.168.1.50
MQTT_PORT=1883
MQTT_USER=smartcenter
MQTT_PASSWORD=change-me

# Frigate / go2rtc：端口需已映射到局域网，或走反向代理
# 也可用 JSON 一次性塞进 SMARTCENTER_OPTIONS
SMARTCENTER_OPTIONS={"door_cameras":["front_desk"],"door_zones":["front_desk_zone"],"door_node":"front_gate","frigate_url":"http://192.168.1.50:5000","go2rtc_url":"http://192.168.1.50:1984","cloud_base_url":"","cloud_hmac_secret":"","match_threshold":0.42,"verify_threshold":0.48,"cooldown_sec":30,"required_enroll_frames":5,"required_match_frames":3,"model_version":"mock-v1","embedder":"mock"}
